# Copy this file to .env and fill in your own values. .env is gitignored.

# Upstox app credentials.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# The redirect URL registered on the Upstox app. On a run with no usable
# stored token the bot serves this URL's path on its port, logs the Upstox
# login URL for you to open, and stores the resulting access token in DB_PATH
# for the rest of the trading day.
UPSTOX_REDIRECT_URL=http://127.0.0.1:9880/upstox/callback

# What to trade.
SYMBOL_EXCHANGE=NSE
SYMBOL=RELIANCE

# Strategy knobs.
FAST_SMA=20
SLOW_SMA=50
STOP_PCT=0.03
RISK_FRACTION=0.01
MAX_TRADES_PER_DAY=3
DAILY_LOSS_LIMIT=2000.00

# Where the SQLite store lives.
DB_PATH=bot.db
