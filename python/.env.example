# Copy this file to .env and fill in your own values. .env is gitignored.

# Upstox app credentials.
UPSTOX_API_KEY=
# From a completed Upstox login, valid for one trading day. There is no login
# flow in this example -- generate it separately and paste it here each morning.
UPSTOX_ACCESS_TOKEN=

# What to trade.
SYMBOL_EXCHANGE=NSE
SYMBOL=RELIANCE

# Strategy knobs.
FAST_SMA=20
SLOW_SMA=50
STOP_PCT=0.03
RISK_FRACTION=0.01
MAX_TRADES_PER_DAY=3
DAILY_LOSS_LIMIT=2000.00

# Where the SQLite store lives.
DB_PATH=bot.db
