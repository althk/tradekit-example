# Copy this file to .env and fill in your own values. .env is gitignored.

# "live" places real orders through the zerodha adapter. "backtest" replays
# the same rule through core/paper and go/backtest instead.
MODE=live

# Kite Connect app credentials.
KITE_API_KEY=
KITE_API_SECRET=
# From a completed Kite login (kiteconnect.LoginURL -> Login), valid for one
# trading day. There is no login flow in this example — generate it separately
# and paste it here each morning.
KITE_ACCESS_TOKEN=

# What to trade.
SYMBOL_EXCHANGE=NSE
SYMBOL=RELIANCE

# Strategy knobs.
FAST_SMA=20
SLOW_SMA=50
STOP_PCT=0.03
RISK_FRACTION=0.01
MAX_TRADES_PER_DAY=3
DAILY_LOSS_LIMIT=2000.00

# Where the SQLite store lives. Both modes write here — live orders and
# backtest runs are both queryable from the same database afterward.
DB_PATH=bot.db

# backtest mode only.
BACKTEST_CASH=1000000.00
REPORT_PATH=report.html
