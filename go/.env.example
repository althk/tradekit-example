# Copy this file to .env and fill in your own values. .env is gitignored.

# "live" places real orders through the zerodha adapter. "backtest" replays
# the same rule through core/paper and go/backtest instead.
MODE=live

# Kite Connect app credentials.
KITE_API_KEY=
KITE_API_SECRET=
# The redirect URL registered on the Kite Connect app. On a run with no
# usable stored token the bot serves this URL's path on its port, logs the
# Kite login URL for you to open, and stores the resulting access token in
# DB_PATH for the rest of the trading day.
KITE_REDIRECT_URL=http://127.0.0.1:9880/kite/callback

# What to trade.
SYMBOL_EXCHANGE=NSE
SYMBOL=RELIANCE

# Strategy knobs.
FAST_SMA=20
SLOW_SMA=50
STOP_PCT=0.03
RISK_FRACTION=0.01
MAX_TRADES_PER_DAY=3
DAILY_LOSS_LIMIT=2000.00

# Where the SQLite store lives. Both modes write here — live orders and
# backtest runs are both queryable from the same database afterward.
DB_PATH=bot.db

# backtest mode only.
BACKTEST_CASH=1000000.00
REPORT_PATH=report.html
